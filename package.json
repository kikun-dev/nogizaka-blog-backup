{
  "name": "sakamichi-blog-backup",
  "version": "1.1.0",
  "description": "Save Sakamichi official blog posts and photos from a local web app or CLI.",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "archive": "node archive-sakamichi-blog.mjs",
    "check": "node --check archive-sakamichi-blog.mjs",
    "test": "npm run check && npm run typecheck && node --experimental-transform-types tests/job-safety.mjs && node tests/archive-engine.mjs && node --experimental-transform-types tests/catalog.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kikun-dev/nogizaka-blog-backup.git"
  },
  "keywords": [
    "sakamichi",
    "nogizaka46",
    "sakurazaka46",
    "hinatazaka46",
    "archive",
    "playwright"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "next": "^16.0.0",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.0.0"
  }
}
