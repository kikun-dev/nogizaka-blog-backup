# Optional output directory for the local runner.
LOCAL_ARCHIVE_ROOT=.local-data/archive

# Required for both job creation and status checks. Use a long random value.
LOCAL_ACCESS_TOKEN=replace-with-a-long-random-token

# Public mode (set the same APP_MODE on Vercel and the local worker).
# APP_MODE=public
# SITE_URL=<optional public site origin for absolute OGP image URLs; Vercel system URL is used by default>
# Friend access codes are issued with `npm run access-codes -- create --name <label>`.
# The plaintext is shown once; store it securely and never add it to environment variables.
# SUPABASE_URL=<project URL; Web and worker>
# SUPABASE_SECRET_KEY=<server-only secret key; Web and worker>
# R2_ACCOUNT_ID=<Cloudflare account ID; Web and worker>
# R2_BUCKET_NAME=sakamichi-blog-backup
# R2_ACCESS_KEY_ID=<Web: bucket read-only key; worker: bucket read/write key>
# R2_SECRET_ACCESS_KEY=<matching secret key>
# WORKER_OUTPUT_ROOT=<absolute WSL/Linux directory; worker only>
